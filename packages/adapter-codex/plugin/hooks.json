{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "acc-hook sessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "acc-hook beforeTurn"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Bash|shell",
        "hooks": [
          {
            "type": "command",
            "command": "acc-hook guard"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "acc-hook finish"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "acc-hook sessionEnd"
          }
        ]
      }
    ]
  }
}
+#[tokio::test]
+async fn poll_is_cached_until_due_and_rejects_old_thread_and_widget_results() {
+    let mut provider = ExternalStatusProvider::new(Some(argv("exec sleep 5")));
+    let (tx, _rx) = tokio::sync::mpsc::unbounded_channel();
+    let tx = AppEventSender::new(tx);
+    let frame = FrameRequester::test_dummy();
+    let a = context(ThreadId::new());
+    let b = context(ThreadId::new());
+    let now = Instant::now();
+    provider.poll(None, &tx, &frame, now);
+    assert!(provider.pending.is_none());
+    provider.poll(Some(a.clone()), &tx, &frame, now);
+    let first = provider.pending.as_ref().unwrap().key.clone();
+    provider.poll(
+        Some(a.clone()),
+        &tx,
+        &frame,
+        now + Duration::from_millis(200),
+    );
+    assert_eq!(provider.pending.as_ref().unwrap().key, first);
+    assert!(provider.apply(ProviderUpdate {
+        key: first.clone(),
+        line: Some(Line::from("first"))
+    }));
+    provider.poll(
+        Some(a.clone()),
+        &tx,
+        &frame,
+        now + Duration::from_millis(900),
+    );
+    assert!(provider.pending.is_none());
+    provider.poll(Some(a.clone()), &tx, &frame, now + POLL_INTERVAL);
+    let second = provider.pending.as_ref().unwrap().key.clone();
+    assert_ne!(second, first);
+    assert!(provider.apply(ProviderUpdate {
+        key: second.clone(),
+        line: None
+    }));
+    assert!(
+        provider.line.is_none(),
+        "a failed refresh clears previous success"
+    );
+
+    provider.poll(Some(b), &tx, &frame, now + POLL_INTERVAL);
+    assert!(provider.line.is_none());
+    provider.poll(Some(a.clone()), &tx, &frame, now + POLL_INTERVAL);
+    assert!(!provider.apply(ProviderUpdate {
+        key: second,
+        line: Some(Line::from("stale A"))
+    }));
+
+    let mut replacement = ExternalStatusProvider::new(Some(argv("exec sleep 5")));
+    replacement.poll(Some(a), &tx, &frame, now);
+    assert!(!replacement.apply(ProviderUpdate {
+        key: first,
+        line: Some(Line::from("old widget"))
+    }));
+    let current = provider.pending.as_ref().unwrap().key.clone();
+    assert!(provider.apply(ProviderUpdate {
+        key: current,
+        line: None
+    }));
+    assert!(provider.line.is_none());
+}

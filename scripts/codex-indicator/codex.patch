+#[cfg(unix)]
+#[tokio::test]
+async fn idle_provider_schedules_native_frame_and_refreshes_without_input() {
+    let mut provider = ExternalStatusProvider::new(Some(argv(
+        "cat >/dev/null; printf '{\"spans\":[{\"text\":\"idle\"}]}'",
+    )));
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+    let tx = AppEventSender::new(tx);
+    let (draw_tx, mut draws) = tokio::sync::broadcast::channel(8);
+    let frame = FrameRequester::new(draw_tx);
+    let context = context(ThreadId::new());
+    provider.poll(Some(context.clone()), &tx, &frame, Instant::now());
+    let Some(AppEvent::ExternalStatusUpdated(first)) =
+        tokio::time::timeout(Duration::from_secs(2), rx.recv())
+            .await
+            .unwrap()
+    else {
+        panic!("expected provider completion");
+    };
+    let first_key = first.key.clone();
+    assert!(provider.apply(first));
+    tokio::time::timeout(Duration::from_secs(2), draws.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    provider.poll(Some(context), &tx, &frame, Instant::now());
+    let Some(AppEvent::ExternalStatusUpdated(second)) =
+        tokio::time::timeout(Duration::from_secs(2), rx.recv())
+            .await
+            .unwrap()
+    else {
+        panic!("expected idle refresh");
+    };
+    assert_ne!(second.key, first_key);
+    assert!(provider.apply(second));
+    assert_eq!(provider.line.as_ref().unwrap().spans[0].content, "idle");
+}

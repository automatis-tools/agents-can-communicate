+#[tokio::test]
+async fn timeout_cleans_up_provider_descendants() {
+    let directory = tempfile::tempdir().unwrap();
+    let marker = directory.path().join("orphan-finished");
+    let mut command = argv("(sleep 0.4; touch \"$1\") & wait");
+    command.push("provider-test".into());
+    command.push(marker.to_str().unwrap().into());
+    assert_eq!(
+        run_provider(
+            &command,
+            &context(ThreadId::new()),
+            Duration::from_millis(100)
+        )
+        .await,
+        Err("provider timed out")
+    );
+    tokio::time::sleep(Duration::from_millis(650)).await;
+    assert!(
+        !marker.exists(),
+        "timed-out provider descendants must not keep running"
+    );
+}

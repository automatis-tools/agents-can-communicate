+use super::*;
+use pretty_assertions::assert_eq;
+use ratatui::style::Modifier;
+
+fn argv(command: &str) -> Vec<String> {
+    vec!["/bin/sh".into(), "-c".into(), command.into()]
+}
+
+fn context(thread_id: ThreadId) -> ProviderContext {
+    ProviderContext {
+        thread_id,
+        cwd: std::env::temp_dir(),
+    }
+}
+
+#[test]
+fn parses_explicit_glyph_color_without_theme_softening_or_background() {
+    let line =
+        parse_output(br#"{"spans":[{"text":"\u25cf","foreground":[44,122,57],"bold":true}]}"#)
+            .unwrap()
+            .unwrap();
+    assert_eq!(line.spans.len(), 1);
+    assert_eq!(line.spans[0].content, "●");
+    assert_eq!(line.spans[0].style.fg, Some(rgb_color((44, 122, 57))));
+    assert_eq!(line.spans[0].style.bg, None);
+    assert!(line.spans[0].style.add_modifier.contains(Modifier::BOLD));
+}
+
+#[test]
+fn rejects_control_sequences_invalid_colors_and_oversized_content() {
+    for bytes in [
+        br#"{"spans":[{"text":"\u001b[32m"}]}"#.as_slice(),
+        br#"{"spans":[{"text":"first\nsecond"}]}"#,
+        br#"{"spans":[{"text":"x","foreground":[256,0,0]}]}"#,
+        br#"{"spans":[{"text":"x","background":[0,0,0]}]}"#,
+        b"not json",
+    ] {
+        assert!(parse_output(bytes).is_err());
+    }
+    let oversized = serde_json::to_vec(&serde_json::json!({
+        "spans": [{ "text": "x".repeat(MAX_TEXT_BYTES + 1) }]
+    }))
+    .unwrap();
+    assert!(parse_output(&oversized).is_err());
+    assert!(parse_output(&vec![b' '; MAX_OUTPUT_BYTES + 1]).is_err());
+    assert_eq!(parse_output(br#"{"spans":[]}"#).unwrap(), None);
+}
+
+#[test]
+fn leads_with_external_spans_without_replacing_or_reordering_builtin_items() {
+    let mut provider = ExternalStatusProvider::new(None);
+    provider.line =
+        parse_output(br#"{"spans":[{"text":"\u25cf","foreground":[44,122,57]}]}"#).unwrap();
+    let builtin = Line::from("model · project · Context 50% left");
+    let rendered = provider.compose_with(Some(builtin.clone()), true).unwrap();
+    assert_eq!(rendered.spans[0].content, "●");
+    assert_eq!(rendered.spans[0].style.fg, Some(rgb_color((44, 122, 57))));
+    assert_eq!(rendered.spans[1].content, " · ");
+    assert_eq!(rendered.spans[2], builtin.spans[0]);
+}
+
+#[test]
+fn external_glyph_survives_native_footer_truncation() {
+    let mut provider = ExternalStatusProvider::new(None);
+    provider.line =
+        parse_output(br#"{"spans":[{"text":"\u25cf","foreground":[44,122,57]}]}"#).unwrap();
+    let builtin = Line::from("model · /very/long/project/directory · long-thread-identifier");
+    let line = provider.compose_with(Some(builtin), true).unwrap();
+    let truncated = crate::line_truncation::truncate_line_with_ellipsis_if_overflow(line, 20);
+    assert_eq!(truncated.spans[0].content, "●");
+    assert_eq!(truncated.spans[0].style.fg, Some(rgb_color((44, 122, 57))));
+    assert!(truncated.width() <= 20);
+}
+
+#[test]
+fn opt_in_accepts_only_nonempty_bounded_argv() {
+    assert_eq!(
+        parse_argv(r#"["/tmp/provider","--json"]"#).unwrap(),
+        ["/tmp/provider", "--json"]
+    );
+    for value in [
+        "[]",
+        r#"[""]"#,
+        r#""/tmp/provider --json""#,
+        "null",
+        r#"["bad\u0000path"]"#,
+    ] {
+        assert!(parse_argv(value).is_err());
+    }
+}
+
+#[cfg(unix)]
+#[tokio::test]
+async fn provider_receives_exact_thread_and_cwd_as_json_stdin() {
+    let context = context(ThreadId::new());
+    let directory = tempfile::tempdir().unwrap();
+    let capture = directory.path().join("input.json");
+    let mut command = argv("cat > \"$1\"; printf '{\"spans\":[{\"text\":\"ok\"}]}'");
+    command.push("provider-test".into());
+    command.push(capture.to_str().unwrap().into());
+    let line = run_provider(&command, &context, PROVIDER_TIMEOUT)
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(line.spans[0].content, "ok");
+
+    let input = std::fs::read(capture).unwrap();
+    let decoded: serde_json::Value = serde_json::from_slice(&input).unwrap();
+    assert_eq!(decoded["thread_id"], context.thread_id.to_string());
+    assert_eq!(decoded["cwd"], context.cwd.to_string_lossy().as_ref());
+}
+
+#[cfg(unix)]
+#[tokio::test]
+async fn rejects_flooding_failed_and_timed_out_processes() {
+    let context = context(ThreadId::new());
+    assert_eq!(
+        run_provider(&argv("exec sleep 5"), &context, Duration::from_millis(30)).await,
+        Err("provider timed out")
+    );
+    assert_eq!(
+        run_provider(&argv("exec yes x"), &context, PROVIDER_TIMEOUT).await,
+        Err("provider output too large")
+    );
+    assert!(
+        run_provider(&argv("exit 1"), &context, PROVIDER_TIMEOUT)
+            .await
+            .is_err()
+    );
+}

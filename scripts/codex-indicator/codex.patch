index 0000000..5b05823
--- /dev/null
+++ b/codex-rs/tui/src/external_status_process.rs
@@ -0,0 +1,75 @@
+//! A bounded local command whose process group is owned by one footer request.
+use super::MAX_OUTPUT_BYTES;
+use super::ProviderContext;
+use super::parse_output;
+use ratatui::text::Line;
+use std::process::Stdio;
+use std::time::Duration;
+use tokio::io::AsyncReadExt;
+use tokio::io::AsyncWriteExt;
+use tokio::process::Command;
+
+#[cfg(unix)]
+struct ProcessGroup(u32);
+
+#[cfg(unix)]
+impl Drop for ProcessGroup {
+    fn drop(&mut self) {
+        // The command creates this group before exec. It contains only this request's
+        // provider and descendants. Drop runs on timeout, cancellation and success.
+        unsafe {
+            libc::kill(-(self.0 as i32), libc::SIGKILL);
+        }
+    }
+}
+
+pub(super) async fn run_provider(
+    argv: &[String],
+    context: &ProviderContext,
+    timeout: Duration,
+) -> Result<Option<Line<'static>>, &'static str> {
+    tokio::time::timeout(timeout, async {
+        let executable = argv.first().ok_or("missing provider executable")?;
+        let mut command = Command::new(executable);
+        command
+            .args(&argv[1..])
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .kill_on_drop(true);
+        #[cfg(unix)]
+        command.process_group(0);
+        let mut child = command.spawn().map_err(|_| "provider spawn failed")?;
+        #[cfg(unix)]
+        let _group = ProcessGroup(child.id().ok_or("missing provider pid")?);
+        let mut input = serde_json::to_vec(context).map_err(|_| "invalid provider input")?;
+        input.push(b'\n');
+        let mut stdin = child.stdin.take().ok_or("missing provider stdin")?;
+        stdin
+            .write_all(&input)
+            .await
+            .map_err(|_| "provider stdin failed")?;
+        drop(stdin);
+        let stdout = child.stdout.take().ok_or("missing provider stdout")?;
+        let mut bytes = Vec::new();
+        stdout
+            .take((MAX_OUTPUT_BYTES + 1) as u64)
+            .read_to_end(&mut bytes)
+            .await
+            .map_err(|_| "provider stdout failed")?;
+        if bytes.len() > MAX_OUTPUT_BYTES {
+            return Err("provider output too large");
+        }
+        if !child
+            .wait()
+            .await
+            .map_err(|_| "provider wait failed")?
+            .success()
+        {
+            return Err("provider failed");
+        }
+        parse_output(&bytes)
+    })
+    .await
+    .map_err(|_| "provider timed out")?
+}
diff --git a/codex-rs/tui/src/external_status_provider.rs b/codex-rs/tui/src/external_status_provider.rs
new file mode 100644
index 0000000..850810e
--- /dev/null
+++ b/codex-rs/tui/src/external_status_provider.rs
@@ -0,0 +1,271 @@
+//! Opt-in native footer provider for the local Codex build. `CODEX_STATUS_PROVIDER` is a JSON argv array.
+//! The trusted local executable receives `{thread_id,cwd}` on stdin and returns
+//! `{spans:[{text,foreground?:[r,g,b],bold?:bool}]}`. No shell, model, or transcript is involved.
+//! Cached spans refresh each second; explicit colors bypass theme softening without a background.
+
+use crate::app_event::AppEvent;
+use crate::app_event_sender::AppEventSender;
+use crate::style::secondary_text_style;
+use crate::terminal_palette::rgb_color;
+use crate::tui::FrameRequester;
+use codex_protocol::ThreadId;
+use ratatui::style::Style;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use serde::Deserialize;
+use serde::Serialize;
+use std::path::PathBuf;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+use std::time::Instant;
+use tokio::task::JoinHandle;
+
+#[path = "external_status_process.rs"]
+mod process;
+use process::run_provider;
+
+const POLL_INTERVAL: Duration = Duration::from_secs(1);
+const PROVIDER_TIMEOUT: Duration = Duration::from_millis(500);
+const MAX_OUTPUT_BYTES: usize = 4096;
+const MAX_TEXT_BYTES: usize = 256;
+static NEXT_INSTANCE: AtomicU64 = AtomicU64::new(1);
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub(crate) struct ProviderContext {
+    pub(crate) thread_id: ThreadId,
+    pub(crate) cwd: PathBuf,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct RequestKey {
+    instance: u64,
+    sequence: u64,
+    context: ProviderContext,
+}
+
+#[derive(Debug)]
+pub(crate) struct ProviderUpdate {
+    key: RequestKey,
+    line: Option<Line<'static>>,
+}
+
+struct PendingRequest {
+    key: RequestKey,
+    task: JoinHandle<()>,
+}
+
+pub(crate) struct ExternalStatusProvider {
+    failure_line: Option<Line<'static>>,
+    argv: Option<Vec<String>>,
+    instance: u64,
+    sequence: u64,
+    context: Option<ProviderContext>,
+    pending: Option<PendingRequest>,
+    next_poll_at: Option<Instant>,
+    line: Option<Line<'static>>,
+}
+
+impl ExternalStatusProvider {
+    pub(crate) fn from_env() -> Self {
+        let argv = std::env::var("CODEX_STATUS_PROVIDER")
+            .ok()
+            .and_then(|value| parse_argv(&value).ok());
+        let mut provider = Self::new(argv);
+        provider.failure_line = std::env::var("CODEX_STATUS_PROVIDER_FALLBACK")
+            .ok()
+            .and_then(|value| parse_output(value.as_bytes()).ok())
+            .flatten();
+        provider
+    }
+
+    fn new(argv: Option<Vec<String>>) -> Self {
+        Self {
+            failure_line: None,
+            argv,
+            instance: NEXT_INSTANCE.fetch_add(1, Ordering::Relaxed),
+            sequence: 0,
+            context: None,
+            pending: None,
+            next_poll_at: None,
+            line: None,
+        }
+    }
+
+    pub(crate) fn enabled(&self) -> bool {
+        self.argv.is_some()
+    }
+
+    /// Returns whether a context change invalidated the displayed value.
+    pub(crate) fn poll(
+        &mut self,
+        context: Option<ProviderContext>,
+        tx: &AppEventSender,
+        frame: &FrameRequester,
+        now: Instant,
+    ) -> bool {
+        if !self.enabled() {
+            return false;
+        }
+        let changed = self.context != context;
+        if changed {
+            self.cancel_pending();
+            self.context = context;
+            self.line = None;
+            self.next_poll_at = None;
+        }
+        let Some(context) = self.context.clone() else {
+            return changed;
+        };
+        if self.pending.is_none() && self.next_poll_at.is_none_or(|deadline| now >= deadline) {
+            self.sequence += 1;
+            let key = RequestKey {
+                instance: self.instance,
+                sequence: self.sequence,
+                context,
+            };
+            let argv = self.argv.clone().unwrap_or_default();
+            let event_key = key.clone();
+            let tx = tx.clone();
+            let failure_line = self.failure_line.clone();
+            let task = tokio::spawn(async move {
+                let line = match run_provider(&argv, &event_key.context, PROVIDER_TIMEOUT).await {
+                    Ok(line) => line,
+                    Err(error) => {
+                        tracing::debug!(error, "external status provider unavailable");
+                        failure_line
+                    }
+                };
+                tx.send(AppEvent::ExternalStatusUpdated(ProviderUpdate {
+                    key: event_key,
+                    line,
+                }));
+            });
+            self.pending = Some(PendingRequest { key, task });
+            self.next_poll_at = Some(now + POLL_INTERVAL);
+        }
+        let delay = self.next_poll_at.map_or(POLL_INTERVAL, |deadline| {
+            let remaining = deadline.saturating_duration_since(now);
+            if remaining.is_zero() {
+                POLL_INTERVAL
+            } else {
+                remaining
+            }
+        });
+        frame.schedule_frame_in(delay);
+        changed
+    }
+
+    pub(crate) fn apply(&mut self, update: ProviderUpdate) -> bool {
+        if self.pending.as_ref().map(|pending| &pending.key) != Some(&update.key)
+            || self.context.as_ref() != Some(&update.key.context)
+        {
+            return false;
+        }
+        self.cancel_pending();
+        self.line = update.line;
+        true
+    }
+
+    pub(crate) fn compose_with(
+        &self,
+        line: Option<Line<'static>>,
+        use_colors: bool,
+    ) -> Option<Line<'static>> {
+        let Some(external) = &self.line else {
+            return line;
+        };
+        let mut line = line.unwrap_or_default();
+        let mut spans = external.spans.clone();
+        if !line.spans.is_empty() {
+            spans.push(Span::styled(" · ", secondary_text_style()));
+        }
+        if !use_colors {
+            for span in &mut spans {
+                span.style.fg = None;
+            }
+        }
+        spans.append(&mut line.spans);
+        line.spans = spans;
+        Some(line)
+    }
+
+    fn cancel_pending(&mut self) {
+        if let Some(pending) = self.pending.take() {
+            pending.task.abort();
+        }
+    }
+}
+
+impl Drop for ExternalStatusProvider {
+    fn drop(&mut self) {
+        self.cancel_pending();
+    }
+}
+
+fn parse_argv(value: &str) -> Result<Vec<String>, &'static str> {
+    if value.len() > MAX_OUTPUT_BYTES {
+        return Err("provider argv too large");
+    }
+    let argv: Vec<String> = serde_json::from_str(value).map_err(|_| "invalid provider argv")?;
+    if argv.is_empty() || argv[0].is_empty() || argv.iter().any(|arg| arg.contains('\0')) {
+        return Err("provider argv must contain an executable");
+    }
+    Ok(argv)
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Output {
+    spans: Vec<OutputSpan>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct OutputSpan {
+    text: String,
+    foreground: Option<[u8; 3]>,
+    #[serde(default)]
+    bold: bool,
+}
+
+fn parse_output(bytes: &[u8]) -> Result<Option<Line<'static>>, &'static str> {
+    if bytes.len() > MAX_OUTPUT_BYTES {
+        return Err("provider output too large");
+    }
+    let output: Output = serde_json::from_slice(bytes).map_err(|_| "invalid provider output")?;
+    if output.spans.len() > 16
+        || output
+            .spans
+            .iter()
+            .map(|span| span.text.len())
+            .sum::<usize>()
+            > MAX_TEXT_BYTES
+        || output
+            .spans
+            .iter()
+            .any(|span| span.text.chars().any(char::is_control))
+    {
+        return Err("invalid provider text");
+    }
+    let spans: Vec<_> = output
+        .spans
+        .into_iter()
+        .filter(|span| !span.text.is_empty())
+        .map(|span| {
+            let mut style = Style::default();
+            if let Some([r, g, b]) = span.foreground {
+                style = style.fg(rgb_color((r, g, b)));
+            }
+            if span.bold {
+                style = style.bold();
+            }
+            Span::styled(span.text, style)
+        })
+        .collect();
+    Ok((!spans.is_empty()).then(|| Line::from(spans)))
+}
+

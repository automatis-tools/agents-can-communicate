---
import InstallCommand from "../InstallCommand.astro";
import ActionLink from "../ActionLink.astro";
import { getArticles } from "../../lib/content";
import { clientFor } from "../../data/editorial";
import { ordered, REPOSITORY } from "../../data/site";
const clients = ordered((await getArticles()).filter(article => article.section === "integrations"));
---
<section class="tool-intro"><div class="helper-copy"><p class="product-name">Agents Can Communicate</p><h1>The missing link<br>between your coding agents.</h1><p class="tool-description">Stop carrying messages between windows. ACC connects your separately opened coding sessions so they can ask questions, review changes, and pass work on.</p><ul class="hero-clients" aria-label="Supported coding clients">{clients.map(article => <li><a href={article.route}>{clientFor(article).name}</a></li>)}</ul><div class="tool-install" id="install"><InstallCommand/><div class="install-links"><ActionLink href="/docs/install/">Connect your agents</ActionLink><a href={REPOSITORY}>GitHub</a></div><p>Open source · Node.js 24+ · No ACC account</p></div></div><div class="helper-object" aria-hidden="true"><img src="/assets/acc-helper-v1.webp" width="900" height="600" alt="" fetchpriority="high" decoding="async"></div></section>

---
import Icon from "./Icon.astro";
import { getSection } from "../data/site";
import type { Article } from "../lib/types";
interface Props { article: Article; }
const { article } = Astro.props;
const section = getSection(article.section);
---
<article class="article-link"><div class="article-link-meta"><span>{section.label}</span><span>{article.minutes} min read</span></div>
  <h2><a href={article.route}>{article.title}</a></h2><p>{article.description}</p>
  <a class="text-link" href={article.route} aria-label={`Read the article: ${article.title}`}>Read the article<Icon name="arrow"/></a>
</article>

---
import ArticleHeading from "../ArticleHeading.astro";
import ArticleMeta from "../ArticleMeta.astro";
import ArticleIllustration from "../ArticleIllustration.astro";
import Contents from "../Contents.astro";
import ExpandableContents from "../ExpandableContents.astro";
import Manuscript from "../Manuscript.astro";
import { method } from "../../data/site";
import type { Article } from "../../lib/types";
interface Props { article: Article; articles: Article[]; }
const { article, articles } = Astro.props;
const neighbours = articles.filter(item => item.section === "docs").sort((a,b) => (a.order ?? 99) - (b.order ?? 99));
---
<div class="reference-workspace"><aside class="reference-sidebar"><a class="reference-home" href="/docs/">Documentation</a>
  <nav aria-label="Documentation pages">{neighbours.map(item => <a href={item.route} aria-current={item.route === article.route ? "page" : undefined}>{item.id === "supported-clients-and-delivery" ? "Clients and delivery" : item.title}</a>)}</nav>
  <Contents article={article}/><a class="reference-search" href="/search/">Search the library</a><ArticleIllustration article={article} class="article-illustration docs-rail-art"/>
</aside><div class="reference-manuscript"><header class="reference-heading"><ArticleHeading article={article}/></header>
  <div class="reference-mobile-contents"><ExpandableContents article={article} label="On this page"/></div><Manuscript article={article}/><ArticleIllustration article={article} class="article-illustration docs-mobile-art"/>
  <footer class="reference-revision"><div class="article-review"><ArticleMeta article={article}/></div><p class="method-note">{method(article)}</p></footer>
</div></div>

---
import DocumentationLayout from "../DocumentationLayout.astro";
import ArticleHeading from "../ArticleHeading.astro";
import ArticleMeta from "../ArticleMeta.astro";
import ArticleIllustration from "../ArticleIllustration.astro";
import Contents from "../Contents.astro";
import ExpandableContents from "../ExpandableContents.astro";
import Manuscript from "../Manuscript.astro";
import { method } from "../../data/site";
import type { Article } from "../../lib/types";
interface Props { article: Article; articles: Article[]; }
const { article, articles } = Astro.props;
---
<DocumentationLayout articles={articles} current={article.route}>
  <Fragment slot="sidebar"><Contents article={article}/><ArticleIllustration article={article} class="article-illustration docs-rail-art"/></Fragment>
<div class="reference-manuscript"><header class="reference-heading"><ArticleHeading article={article}/></header>
  <div class="reference-mobile-contents"><ExpandableContents article={article} label="On this page"/></div><Manuscript article={article}/><ArticleIllustration article={article} class="article-illustration docs-mobile-art"/>
  <footer class="reference-revision"><div class="article-review"><ArticleMeta article={article}/></div><p class="method-note">{method(article)}</p></footer>
</div></DocumentationLayout>

---
import { clientFor } from "../../data/editorial";
import ArticleHeading from "../ArticleHeading.astro";
import ArticleMeta from "../ArticleMeta.astro";
import ArticleIllustration from "../ArticleIllustration.astro";
import ExpandableContents from "../ExpandableContents.astro";
import Manuscript from "../Manuscript.astro";
import { method } from "../../data/site";
import type { Article } from "../../lib/types";
interface Props { article: Article; articles: Article[]; }
const { article } = Astro.props;
const client = clientFor(article);
---
<header class="setup-heading"><div class="setup-identity"><strong>{client.name}</strong><span>{client.surface}</span><ArticleIllustration article={article} class="article-illustration integration-art"/></div>
  <div class="setup-title"><ArticleHeading article={article}/><div class="article-review"><ArticleMeta article={article}/></div></div></header>
<div class="setup-toolbar"><ExpandableContents article={article} label="Setup and usage"/><a href="/compatibility/">Delivery and compatibility</a></div>
<div class="setup-manuscript"><Manuscript article={article}/></div><p class="setup-method method-note">{method(article)}</p>
